{
  "name": "losql",
  "version": "0.2.0",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "bin": { "losql": "src/main.ts" },
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test src test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "build": "bun run ./build.ts",
    "verify:tui": "bun run build && scripts/verify-tui.sh"
  },
  "dependencies": {
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "postgres": "^4.1.1",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
