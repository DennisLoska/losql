{
  "name": "losql",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "ui": "bun run --watch src/tui/app.tsx",
    "server": "bun run --watch src/server/app.ts",
    "build": "bun run ./build.ts",
    "release": "bun build --compile ./dist/main.js --outfile losql"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@opentui/core": "^0.1.66",
    "@opentui/solid": "^0.1.66",
    "babel-preset-solid": "1.9.9",
    "solid-js": "1.9.9"
  }
}
