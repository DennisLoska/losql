{
  "name": "losql",
  "version": "0.2.0",
  "description": "A vim-first SQL client for the terminal, with an agent on board. SQLite and Postgres, one binary, no API keys.",
  "homepage": "https://losql.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DennisLoska/losql.git"
  },
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "bin": { "losql": "src/main.ts" },
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test src test landing/tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "build": "bun run ./build.ts",
    "landing:build": "node ./landing/build.mjs",
    "verify:tui": "bun run build && scripts/verify-tui.sh"
  },
  "dependencies": {
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "postgres": "^4.1.1",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
